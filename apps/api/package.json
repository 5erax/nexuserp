{
  "name": "@nexus/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:generate && nest start --watch --no-shell",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "jest --runInBand --testPathIgnorePatterns=integration --coverage --coverageDirectory=coverage/unit",
    "test:integration": "node scripts/test-integration.cjs",
    "test:integration:foundation": "node scripts/test-integration.cjs foundation",
    "test:security": "node scripts/test-integration.cjs security",
    "test:security:mutation": "node scripts/check-scope-mutation.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:check": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "sessions:prune": "ts-node scripts/prune-sessions.ts",
    "idempotency:prune": "ts-node scripts/prune-idempotency.ts",
    "iam:bootstrap": "ts-node scripts/bootstrap-iam.ts",
    "openapi": "ts-node scripts/export-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "dotenv": "17.3.1",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "pg": "8.20.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@nexus/config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "22.19.15",
    "@types/pg": "8.16.0",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
