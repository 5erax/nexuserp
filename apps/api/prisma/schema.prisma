generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(32)
  name      String     @db.VarChar(200)
  currency  String     @default("VND") @db.VarChar(3)
  timezone  String     @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  branches  Branch[]
  users     User[]
  roles     Role[]
  auditLogs AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  code           String             @db.VarChar(32)
  name           String             @db.VarChar(200)
  status         String             @default("ACTIVE") @db.VarChar(16)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userAccess     UserBranchAccess[]
  auditLogs      AuditLog[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("branches")
}

model User {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @map("organization_id") @db.Uuid
  email              String             @db.VarChar(254)
  displayName        String             @map("display_name") @db.VarChar(200)
  passwordHash       String             @map("password_hash") @db.VarChar(512)
  mustChangePassword Boolean            @default(false) @map("must_change_password")
  status             String             @default("ACTIVE") @db.VarChar(16)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  roles              UserRole[]
  branches           UserBranchAccess[]
  families           RefreshFamily[]
  auditLogs          AuditLog[]

  @@unique([organizationId, email])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  code           String           @db.VarChar(64)
  name           String           @db.VarChar(200)
  isSystem       Boolean          @default(false) @map("is_system")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users          UserRole[]
  permissions    RolePermission[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("roles")
}

model Permission {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique @db.VarChar(100)
  allowedScopes String           @map("allowed_scopes") @db.VarChar(32)
  roles         RolePermission[]

  @@map("permissions")
}

model UserRole {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  role           Role     @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model RolePermission {
  organizationId String     @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionId   String     @map("permission_id") @db.Uuid
  scope          String     @db.VarChar(8)
  role           Role       @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserBranchAccess {
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  branchId       String   @map("branch_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User     @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  branch         Branch   @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)

  @@id([userId, branchId])
  @@index([organizationId, branchId])
  @@map("user_branch_access")
}

model RefreshFamily {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?        @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  user           User             @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict)
  sessions       RefreshSession[]

  @@unique([organizationId, id])
  @@index([userId, expiresAt])
  @@map("refresh_families")
}

model RefreshSession {
  id          String          @id @default(uuid()) @db.Uuid
  familyId    String          @map("family_id") @db.Uuid
  tokenHash   String          @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  rotatedAt   DateTime?       @map("rotated_at") @db.Timestamptz(3)
  revokedAt   DateTime?       @map("revoked_at") @db.Timestamptz(3)
  replacedBy  String?         @map("replaced_by") @db.Uuid
  ip          String?         @db.VarChar(64)
  userAgent   String?         @map("user_agent") @db.VarChar(512)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  family      RefreshFamily   @relation(fields: [familyId], references: [id], onDelete: Restrict)
  successor   RefreshSession? @relation("Rotation", fields: [familyId, replacedBy], references: [familyId, id], onDelete: Restrict)
  predecessor RefreshSession? @relation("Rotation")

  @@unique([familyId, id])
  @@unique([familyId, replacedBy])
  @@index([familyId, expiresAt])
  @@map("refresh_sessions")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  actorId        String?      @map("actor_id") @db.Uuid
  action         String       @db.VarChar(100)
  entityType     String       @map("entity_type") @db.VarChar(64)
  entityId       String?      @map("entity_id") @db.Uuid
  requestId      String       @map("request_id") @db.VarChar(64)
  ip             String?      @db.VarChar(64)
  userAgent      String?      @map("user_agent") @db.VarChar(512)
  changes        Json
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch?      @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  actor          User?        @relation(fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, createdAt, id])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@map("audit_logs")
}
