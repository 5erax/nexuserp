{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["packages/config/**"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "dependsOn": ["^build", "^typecheck"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL", "NODE_ENV"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": [],
      "cache": false
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "API_INTERNAL_URL",
        "API_PORT",
        "NODE_ENV",
        "WEB_ORIGIN",
        "JWT_SECRET",
        "CSRF_SECRET",
        "API_RATE_LIMIT"
      ]
    }
  }
}
